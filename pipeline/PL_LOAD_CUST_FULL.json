					"referenceName": "AzureSqlDatabase1",
					"type": "LinkedServiceReference"
				},
				"typeProperties": {
					"scripts": [
						{
							"type": "Query",
							"text": {
								"value": "INSERT INTO WATERMARK (\n    WATERMARK_ID,\n    SOURCE_NAME,\n    TABLE_NAME,\n    WATERMARK_COLUMN,\n    WATERMARK_VALUE,\n    LAST_UPDATED_DATE,\n    COMMENTS\n)\nVALUES (\n    1,\n    'Retail_ADLS',\n    'CUSTOMER',\n    'MODIFIED_DATE',\n    '@{activity('Get_Latest_mod_Date').output.firstRow.LAT_MOD_DATE}',\n    GETDATE(),\n    'Initial load watermark for CUSTOMER table'\n);",
								"type": "Expression"
							}
						}
					],
					"scriptBlockExecutionTimeout": "02:00:00"
				}
			}
		],
