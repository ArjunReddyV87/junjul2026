{
	"name": "PL_Files_Split_dynamic",
	"properties": {
		"activities": [
			{
				"name": "Filter_for_csv_files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "ForEach1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('FileNames')",
						"type": "Expression"
					},
					"condition": {
						"value": "@endsWith(item(), '.csv')\n\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "CSV Files List",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Filter_for_csv_files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "csvfiles_list",
					"value": {
						"value": "@activity('Filter_for_csv_files').output.Value\n\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Filter_for_txt_files",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "ForEach1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@variables('FileNames')",
						"type": "Expression"
					},
					"condition": {
						"value": "@endswith(item(),'txt')",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Text files list",
				"type": "SetVariable",
				"dependsOn": [
					{
						"activity": "Filter_for_txt_files",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"variableName": "textfiles_list",
					"value": {
						"value": "@activity('Filter_for_txt_files').output.Value\n",
						"type": "Expression"
					}
				}
			},
			{
				"name": "Get Metadata1",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "DS_Src_Files_List",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "ForEach1",
				"type": "ForEach",
				"dependsOn": [
					{
						"activity": "Get Metadata1",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Metadata1').output.childItems",
						"type": "Expression"
